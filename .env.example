# LLM API 配置
LLM_API_KEY="your-llm-api-key"
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
# 可选：视觉 OCR 与语音转写模型；配置后图片文字和音频内容才会走真实识别
# 当前已验证：qwen3.7-plus（视觉）+ qwen-audio-3.0-asr-flash（语音）
APP_VISION_MODEL=
APP_ASR_MODEL=
# 可选：视觉/语音使用不同服务商时单独配置；留空则复用 LLM_API_KEY/LLM_BASE_URL
APP_VISION_API_KEY=
APP_VISION_BASE_URL=
APP_ASR_API_KEY=
APP_ASR_BASE_URL=
# auto：DashScope 的 qwen-audio-* 自动走原生 ASR endpoint；
# 其余 DashScope 系列走 chat completions + input_audio；其他服务走 /audio/transcriptions
# 可显式指定 dashscope / chat / native
APP_ASR_TRANSCRIPTION_MODE=auto

# 持久化：local 使用本地 memory；s3 启用对象存储同步（方案/附件/分享令牌）
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=workbench/
S3_REGION=auto
S3_ENDPOINT_URL=

# 应用配置
APP_HOST=127.0.0.1
APP_PORT=8000
LLM_PREFER_PLAIN=true
# DeepSeek V4 结构化 Agent 默认关闭思考模式；如确需长思考可显式设为 false
LLM_DISABLE_THINKING=true
