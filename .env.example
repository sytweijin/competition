# ============ 参赛交付配置说明 ============
# 创新应用赛道要求"应用基于 MiniCPM-o 4.5 全模态能力开发，不得使用其他模型"。
# 交付/演示环境请保持：
#   APP_MODEL_MODE=minicpm
#   APP_ALLOW_EXTERNAL_MODELS=0
# 该模式下代码不会创建任何外部模型客户端（DeepSeek/DashScope 均不可用），
# 全部文本/语音/视觉/音频能力走 MiniCPM-o Realtime（本地昇腾 A3 或云端 ModelBest）。
# 下方的 LLM_* 与 APP_VISION_*/APP_ASR_* 仅为本地开发调试（legacy 模式）预留，
# 参赛交付版本无需配置，请保持为空。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 可选：视觉 OCR 与语音转写模型；仅 legacy 开发模式启用，合规模式被硬禁用
APP_VISION_MODEL=
APP_ASR_MODEL=
# 可选：视觉/语音使用不同服务商时单独配置；留空则复用 LLM_API_KEY/LLM_BASE_URL
APP_VISION_API_KEY=
APP_VISION_BASE_URL=
APP_ASR_API_KEY=
APP_ASR_BASE_URL=
# auto：DashScope 的 qwen-audio-* 自动走原生 ASR endpoint；
# 其余 DashScope 系列走 chat completions + input_audio；其他服务走 /audio/transcriptions
# 可显式指定 dashscope / chat / native
APP_ASR_TRANSCRIPTION_MODE=auto
# 图片/语音模型单次超时与扫描 PDF 最大 OCR 页数
APP_MEDIA_TIMEOUT=20
APP_OCR_MAX_PDF_PAGES=6

# MiniCPM-o Realtime（华为昇腾创新应用赛道，参赛唯一模型）
# 云端后端：填 MAP_REALTIME_API_KEY 即可跑通 Realtime 对话
MAP_REALTIME_API_KEY=
MAP_REALTIME_MODEL=MiniCPM-o-4.5-Realtime
MAP_REALTIME_BASE_URL=wss://api.modelbest.cn/v1/realtime
MAP_REALTIME_MAX_TOKENS=1024
MAP_REALTIME_TIMEOUT=60

# 本地 llama-omni-server（昇腾 A3 上启动后，通过 VSCode 端口转发 28099）
# 配置后优先走本地昇腾，MAP_REALTIME_API_KEY 可留空；
# 演示遇本地不稳定时，注释本行即可切回云端 ModelBest
ASCEND_OMNI_WS_URL=
ASCEND_OMNI_TIMEOUT=300
# 本地昇腾音频适配参数（默认 12 秒分片、10 分钟上限，为 910C 实测稳定值）；
# 若自托管/评审环境使用性能更优的本地后端，可放宽：
APP_LOCAL_AUDIO_CHUNK_SECONDS=12
APP_LOCAL_AUDIO_MAX_SECONDS=600
# 本地 TTS：910C 上游算子已知会挂起单会话服务，默认关闭；
# 仅当本地后端 TTS 确认可用时置 1 开启
APP_LOCAL_TTS_ENABLED=0

# 持久化：local 使用本地 memory；s3 启用对象存储同步（方案/附件/分享令牌）
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=workbench/
S3_REGION=auto
S3_ENDPOINT_URL=

# 应用配置
APP_HOST=127.0.0.1
APP_PORT=8000
# 网页管理端鉴权令牌；公网部署务必设置，保护方案列表/删除/模型调用等 /api 接口
APP_ADMIN_TOKEN=
# 群机器人 Webhook：支持企业微信 / 飞书 / 钉钉，自动按平台适配消息格式
# 多个地址用英文逗号或分号分隔，可同时推送多个群；或把列表写进 APP_NOTIFY_WEBHOOKS
APP_NOTIFY_WEBHOOK=
# 企业微信: https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# 飞书:     https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# 钉钉:     https://oapi.dingtalk.com/robot/send?access_token=xxx
APP_NOTIFY_WEBHOOKS=
LLM_PREFER_PLAIN=true
# 模型模式：minicpm（合规，仅 MiniCPM-o 4.5）/ legacy（开发用 DeepSeek）
APP_MODEL_MODE=minicpm
# 是否允许外部模型兜底（DashScope 视觉/语音）；参赛版本必须为 0
APP_ALLOW_EXTERNAL_MODELS=0
# DeepSeek V4 结构化 Agent 默认关闭思考模式；如确需长思考可显式设为 false
LLM_DISABLE_THINKING=true
